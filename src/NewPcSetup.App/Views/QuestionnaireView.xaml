<UserControl x:Class="NewPcSetup.App.Views.QuestionnaireView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <UserControl.Resources>
    <Style x:Key="Q" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="几个问题" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="这些答案决定方案里出现哪些项。每一项都有默认值，不确定就保持默认。" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ui:Card Padding="20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
          <TextBlock Style="{StaticResource Q}" Text="1. 这台电脑主要用来做什么？" Margin="0,0,0,6" />
          <ComboBox ItemsSource="{Binding UsageOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Usage}" MinWidth="320" />

          <TextBlock Style="{StaticResource Q}" Text="2. 数据盘（软件、文档、缓存都放这里）" />
          <ComboBox ItemsSource="{Binding DataDriveOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DataDrive}" MinWidth="320" />

          <TextBlock Style="{StaticResource Q}" Text="3. 界面风格" />
          <ComboBox ItemsSource="{Binding UiStyleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UiStyle}" MinWidth="320" />
          <ui:ToggleSwitch Content="使用深色模式" IsChecked="{Binding DarkMode}" Margin="0,8,0,0" />

          <TextBlock Style="{StaticResource Q}" Text="4. 微软拼音默认输入模式" />
          <ComboBox ItemsSource="{Binding ImeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ImeMode}" MinWidth="320" />
          <ui:ToggleSwitch Content="保留单击 Shift 切换中英文" IsChecked="{Binding KeepShiftSwitch}" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource Muted}" Text="关闭后只用 Win+空格 或 Ctrl+空格 切换，避免打字时误触 Shift。" Margin="0,4,0,0" />

          <TextBlock Style="{StaticResource Q}" Text="5. 系统推送与建议" />
          <ui:ToggleSwitch Content="关闭锁屏聚焦、开始菜单推荐、搜索联网结果、广告 ID 等推送" IsChecked="{Binding DisablePromotions}" />
          <TextBlock Style="{StaticResource Muted}" Text="默认保留。微软服务与预装应用本工具一律不卸载、不禁用。" Margin="0,4,0,0" />
        </StackPanel>
      </ui:Card>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <ui:Button Content="上一步" Appearance="Secondary" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="恢复默认" Appearance="Secondary" Command="{Binding UseDefaultsCommand}" Margin="0,0,8,0" />
        <ui:Button Content="生成方案" Appearance="Primary" Command="{Binding NextCommand}" MinWidth="120" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
