<UserControl x:Class="NewPcSetup.App.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="C 盘占用" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:Card Padding="14,10" Margin="0,0,0,6">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                      <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextBlockStyle}" FontFamily="Consolas" />
                  <TextBlock Text="{Binding Advice}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Size}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0,0,0" />
              </Grid>
            </ui:Card>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <ui:Button Content="返回" Appearance="Secondary" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
      <ui:Button Content="打开存储设置" Appearance="Secondary" Command="{Binding OpenStorageSettingsCommand}" HorizontalAlignment="Right" />
    </Grid>
  </Grid>
</UserControl>
