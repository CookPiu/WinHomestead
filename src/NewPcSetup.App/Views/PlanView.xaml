<UserControl x:Class="NewPcSetup.App.Views.PlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="方案预览" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,16">
              <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,6" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:Card Padding="14,10" Margin="0,0,0,6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsPlanned}" VerticalAlignment="Top" Margin="0,0,10,0" />
                        <StackPanel Grid.Column="1">
                          <DockPanel>
                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Muted}" DockPanel.Dock="Right" Margin="12,2,0,0" />
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                          </DockPanel>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                          <StackPanel Visibility="{Binding ShowValues, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                              <Run Text="当前：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding CurrentValue, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                              <Run Text="目标：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding TargetValue, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>
                    </ui:Card>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="0,12,0,0">
      <ui:Button Content="上一步" Appearance="Secondary" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
      <ui:Button Content="开始执行" Appearance="Primary" Command="{Binding ExecuteCommand}" HorizontalAlignment="Right" MinWidth="120" />
    </Grid>
  </Grid>
</UserControl>
