<UserControl x:Class="WinHomestead.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WinHomestead.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Summary}" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <ui:InfoBar IsOpen="{Binding RebootRequired, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{local:Loc Zh='需要重启', En='Restart required'}"
                    Message="{local:Loc Zh='部分改动在重启后生效。点“立即重启”会在重启后自动打开本工具确认结果；也可以稍后手动重启。', En='Some changes take effect after a reboot. Restart now and the tool reopens afterwards to confirm the results, or reboot later yourself.'}" Margin="0,0,0,8">
          <ui:InfoBar.Content>
            <ui:Button Content="{local:Loc Zh='立即重启', En='Restart now'}" Appearance="Primary" Command="{Binding RebootNowCommand}" Margin="0,0,0,8" />
          </ui:InfoBar.Content>
        </ui:InfoBar>

        <TextBlock Text="{local:Loc Zh='执行结果', En='Results'}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,8,0,6" />
        <ui:Card Padding="14,8">
          <ItemsControl ItemsSource="{Binding Results}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Outcome}" Margin="12,0,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsOk}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:Card>

        <StackPanel Visibility="{Binding HasManualSteps, Converter={StaticResource BooleanToVisibilityConverter}}">
          <TextBlock Text="{local:Loc Zh='需要你手动处理的事项', En='Needs your attention'}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,16,0,6" />
          <ItemsControl ItemsSource="{Binding ManualSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ui:Card Padding="14,10" Margin="0,0,0,6">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </ui:Card>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
      <ui:Button Content="{local:Loc Zh='打开日志与记录目录', En='Open logs folder'}" Appearance="Secondary" Command="{Binding OpenLogsCommand}" Margin="0,0,6,0" />
      <ui:Button Content="{local:Loc Zh='导出 HTML 报告', En='Export HTML report'}" Appearance="Secondary" Command="{Binding ExportHtmlCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
