<UserControl x:Class="WinHomestead.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WinHomestead.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 头部：探测状态 + 汇总 + 数据盘 + 重新探测 -->
    <ui:Card Padding="14,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock Text="{local:Loc Zh='数据盘', En='Data drive'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox ItemsSource="{Binding DataDriveOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DataDrive}"
                    MinWidth="240" IsEnabled="{Binding HasDataDrive}" Margin="0,0,8,0" />
          <ui:Button Content="{local:Loc Zh='重新探测', En='Re-probe'}" Appearance="Secondary" Command="{Binding DetectCommand}" />
        </StackPanel>
      </Grid>
    </ui:Card>

    <!-- 提示条：只放全局性的警告与待办操作；单个条目的情况写在条目卡片上 -->
    <StackPanel Grid.Row="1">
      <ItemsControl ItemsSource="{Binding Warnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ui:InfoBar IsOpen="{Binding IsOpen, Mode=TwoWay}" IsClosable="True" Severity="Warning" Message="{Binding Text}" Margin="0,0,0,6" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ui:InfoBar IsOpen="{Binding ExplorerRestartPending, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{local:Loc Zh='有改动要重启资源管理器才生效', En='Some changes need an Explorer restart'}"
                  Message="{local:Loc Zh='桌面和任务栏会闪一下，已打开的窗口不受影响。', En='The desktop and taskbar will flicker once. Open windows are unaffected.'}" Margin="0,0,0,6">
        <ui:InfoBar.Content>
          <ui:Button Content="{local:Loc Zh='重启资源管理器', En='Restart Explorer'}" Appearance="Primary" Command="{Binding RestartExplorerCommand}" Margin="0,0,0,8" />
        </ui:InfoBar.Content>
      </ui:InfoBar>
      <ui:InfoBar IsOpen="{Binding RebootPending, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="{local:Loc Zh='有改动需要重启电脑', En='Some changes need a reboot'}"
                  Message="{local:Loc Zh='点“立即重启”会在重启后自动打开本工具确认结果；也可以稍后手动重启。', En='Restart now and the tool reopens afterwards to confirm the results. You can also reboot later yourself.'}" Margin="0,0,0,6">
        <ui:InfoBar.Content>
          <ui:Button Content="{local:Loc Zh='立即重启', En='Restart now'}" Appearance="Primary" Command="{Binding RebootNowCommand}" Margin="0,0,0,8" />
        </ui:InfoBar.Content>
      </ui:InfoBar>
      <StackPanel Orientation="Horizontal" Margin="4,0,0,6"
                  Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}">
        <TextBlock Text="{Binding RunningLabel}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        <ui:Button Content="{local:Loc Zh='停止', En='Stop'}" Appearance="Secondary" Margin="10,0,0,0" Padding="10,2" Command="{Binding StopCommand}"
                   Visibility="{Binding CanStop, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </StackPanel>

    <!-- 左：分类；右：条目 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,12,0" BorderThickness="0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4,6">
              <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedCategory.IsTaskList, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl ItemsSource="{Binding SelectedCategory.Items}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Padding="14,10" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                      <!-- 徽标只写状态词；推荐绿、已满足灰绿、不适用灰，扫一眼能分出哪些做完了 -->
                      <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding ShowRecommendedBadge}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="11">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="{Binding StatusLabel}" />
                              <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSkipped}" Value="True">
                                  <Setter Property="Text" Value="{local:Loc Zh='✓ 已满足', En='✓ done'}" />
                                  <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsNotApplicable}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                    <!-- 不适用的原因单独一行，可换行 -->
                    <TextBlock Text="{Binding ReasonText}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasReason, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <!-- 当前/目标给人话；原始键值放在悬停提示里 -->
                    <StackPanel Visibility="{Binding ShowValues, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDetail}" Value="True">
                              <Setter Property="ToolTip" Value="{Binding Detail}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                        <Run Text="{local:Loc Zh='当前：', En='Now: '}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding CurrentValue, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap">
                        <Run Text="{local:Loc Zh='目标：', En='After: '}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run Text="{Binding TargetValue, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding RiskLabel}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                               Visibility="{Binding ShowRisk, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                          <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultOk}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,0,0,6"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button Content="{Binding ButtonText}" Appearance="Primary" MinWidth="88" Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}"
                               Visibility="{Binding IsPlanned, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button Content="{Binding AuxLabel}" Appearance="Secondary" MinWidth="88" Command="{Binding AuxCommand}"
                               Visibility="{Binding HasAux, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- “这台电脑”：只读硬件信息，容量给精确值 -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding SelectedCategory.IsMachineInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
        <ItemsControl ItemsSource="{Binding MachineInfo}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ui:Card Padding="14,8" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Value}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  </StackPanel>
                </Grid>
              </ui:Card>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
