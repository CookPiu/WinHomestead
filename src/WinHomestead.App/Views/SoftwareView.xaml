<UserControl x:Class="WinHomestead.App.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:WinHomestead.App">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="{local:Loc Zh='软件推荐', En='Software'}" />
      <TextBlock Style="{StaticResource PageSubtitle}"
                 Text="{local:Loc Zh='下面是新机上比较常见的选择，按你自己的需要挑，不用照单全装。工具只给官网入口和一个建议的安装路径，不下载、不代装、不改你的默认程序。', En='Common picks for a new machine. Take what you need — this is not a checklist. The tool only gives you the official download page and a suggested install path; it never downloads, installs, or touches your default apps.'}" />
    </StackPanel>

    <!-- 先把安装目录规划好，再谈装什么 -->
    <ui:Card Grid.Row="1" Padding="14,10" Margin="0,10,0,10">
      <StackPanel>
        <TextBlock Text="{local:Loc Zh='安装目录', En='Install location'}" Style="{StaticResource BodyStrongTextBlockStyle}" />
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{local:Loc Zh='根目录', En='Root'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ui:TextBox Grid.Column="1" Text="{Binding Root, UpdateSourceTrigger=LostFocus}" PlaceholderText="{local:Loc Zh='例如 D:\Applications', En='e.g. D:\Applications'}" />
          <ui:Button Grid.Column="2" Content="{local:Loc Zh='恢复默认', En='Reset'}" Appearance="Secondary" Margin="8,0,0,0" Command="{Binding ResetPathsCommand}" />
        </Grid>
        <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </ui:Card>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,14" Visibility="{Binding AnyVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="4,0,0,2" />
              <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="4,0,0,6" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <ui:Card Padding="14,10" Margin="0,0,0,6" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0" Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                    Visibility="{Binding Installed, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <TextBlock Text="{local:Loc Zh='已安装', En='installed'}" FontSize="11" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            </Border>
                            <Border CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding IsCustomPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <TextBlock Text="{local:Loc Zh='自定义路径', En='custom path'}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap" />
                          <ui:TextBox Text="{Binding RecommendedPath, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                      Visibility="{Binding CanHavePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                          <ui:Button Content="{local:Loc Zh='复制路径', En='Copy path'}" Appearance="Secondary" Command="{Binding CopyPathCommand}" Margin="0,0,6,0"
                                     Visibility="{Binding CanHavePath, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <ui:Button Content="{local:Loc Zh='官网', En='Website'}" Appearance="Secondary" Command="{Binding OpenSiteCommand}" />
                        </StackPanel>
                      </Grid>
                    </ui:Card>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="0,12,0,0">
      <CheckBox Content="{local:Loc Zh='隐藏已安装的', En='Hide installed'}" IsChecked="{Binding HideInstalled}" HorizontalAlignment="Left" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <ui:Button Content="{local:Loc Zh='商店应用保存位置', En='Store app location'}" Appearance="Secondary" Margin="0,0,6,0" Command="{Binding OpenSaveLocationsCommand}"
                   ToolTip="{local:Loc Zh='微软商店安装的新应用默认装在 C 盘，且无公开接口可改。点此打开 设置 → 存储 → 高级存储设置 → 新内容的保存位置。', En='Apps from the Store install to C: by default and there is no public API to change that. This opens Settings → Storage → Advanced storage settings → Where new content is saved.'}" />
        <ui:Button Content="{local:Loc Zh='刷新已安装状态', En='Refresh installed state'}" Appearance="Secondary" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
